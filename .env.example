# debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL ---
# table owner
POSTGRES_DB=loghub
POSTGRES_USER=loghub
POSTGRES_PASSWORD=change-me

# password for loghub_app; `loghub migrate` creates the role and keeps this password in sync
APP_DB_PASSWORD=change-me

# --- Edge ---
# the one name or address browsers use to reach loghub: localhost or a private IP gets a certificate from Caddy's own CA (`make ca` exports it), a public domain gets one from Let's Encrypt
SITE_ADDRESS=localhost

# --- Collector ---
# key for sending events, used by the collector and samples/post_logs.py; it may write to any tenant and read nothing
INGEST_TOKEN=change-me

# tenant every syslog sender's events are stored under; it must exist (`loghub seed` creates demoA, demoB and demoC)
SYSLOG_DEFAULT_TENANT=demoA

# --- Backend ---
# signs sign-in tokens; changing it signs everyone out
AUTH_SECRET=change-me

# bootstrap accounts; `loghub seed` creates them only if missing, so later changes here don't apply
ADMIN_EMAIL=admin@loghub.local
ADMIN_PASSWORD=change-me
VIEWER_PASSWORD=change-me

# --- Optional services ---
# Compose profiles to start with the stack, separated by commas: demo runs samples/simulate.py, and monitoring runs Prometheus and Grafana at https://SITE_ADDRESS/grafana, which ADMIN_EMAIL and ADMIN_PASSWORD sign in to
#COMPOSE_PROFILES=demo,monitoring
